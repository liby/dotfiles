{{- /* chezmoi:modify-template */ -}}
{{- /* Keep the destination plain JSON: fromJson rejects the JSON5 comments Oracle accepts. */ -}}
{{- $managed := includeTemplate "oracle/config.json" . | fromJson -}}
{{- $current := .chezmoi.stdin | default "{}" | fromJson -}}
{{- $out := mergeOverwrite (deepCopy $current) $managed -}}
{{- if deepEqual $current $out -}}
  {{- .chezmoi.stdin -}}
{{- else -}}
  {{- $out | toPrettyJson -}}
{{- end -}}
