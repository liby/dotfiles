{{- /* chezmoi:modify-template */ -}}
{{- /* Overlay only the browser keys below and preserve every other value,
      including App-written bridge state. modelStrategy "current" keeps the
      tab's selection for a hand-run oracle; noFocus keeps Chrome from becoming
      the frontmost app and taking keystrokes typed in another app. Keep the
      destination plain JSON; fromJson rejects the JSON5 comments Oracle
      accepts. Do not add browser.thinkingTime: a config-sourced "current" does
      not suppress it. */ -}}
{{- $managed := dict "modelStrategy" "current" "noFocus" true -}}
{{- $stdin := .chezmoi.stdin -}}
{{- $current := dict -}}
{{- if $stdin -}}{{- $current = fromJson $stdin -}}{{- end -}}
{{- $out := deepCopy $current -}}
{{- $browser := index $out "browser" | default dict -}}
{{- $browser = mergeOverwrite $browser $managed -}}
{{- $out = set $out "browser" $browser -}}
{{- if deepEqual $current $out -}}
  {{- $stdin -}}
{{- else -}}
  {{ toPrettyJson $out }}
{{- end -}}
