{{- /* chezmoi:modify-template */ -}}
{{- /* Overlay only Oracle's browser model strategy, keeping the tab's selection
      for a hand-run oracle, while preserving App-written bridge state and other
      live values. Keep the destination plain JSON; fromJson rejects the JSON5
      comments Oracle accepts. Do not add browser.thinkingTime: a config-sourced
      "current" does not suppress it. */ -}}
{{- $managed := dict "modelStrategy" "current" -}}
{{- $stdin := .chezmoi.stdin -}}
{{- $current := dict -}}
{{- if $stdin -}}{{- $current = fromJson $stdin -}}{{- end -}}
{{- $out := deepCopy $current -}}
{{- $browser := index $out "browser" | default dict -}}
{{- $browser = mergeOverwrite $browser $managed -}}
{{- $out = set $out "browser" $browser -}}
{{- if deepEqual $current $out -}}
  {{- $stdin -}}
{{- else -}}
  {{ toPrettyJson $out }}
{{- end -}}
