{{- /* chezmoi:modify-template */ -}}
{{- $settings := includeTemplate "pi/settings.json" . | fromJson -}}
{{- $stdin := .chezmoi.stdin -}}
{{- $current := dict -}}
{{- if $stdin -}}{{- $current = fromJson $stdin -}}{{- end -}}
{{- $out := deepCopy $current -}}
{{- range $k, $v := $settings -}}{{- $out = set $out $k $v -}}{{- end -}}
{{- if deepEqual $current $out -}}
  {{- $stdin -}}
{{- else -}}
  {{ toPrettyJson $out }}
{{- end -}}
