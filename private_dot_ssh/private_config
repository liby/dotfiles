Include ~/.orbstack/ssh/config
Include config.aws
Include config.vmiss

Host *
  AddKeysToAgent yes
  Compression yes
  ServerAliveInterval 30
  UseKeychain yes

Host github.com
  Hostname ssh.github.com
  Port 443

# The card's authentication key is served by gpg-agent, not the macOS agent.
Host github.com gitlab.*
  IdentityAgent ~/.gnupg/S.gpg-agent.ssh
