{{- /* Read dot_claude/modify_private_settings.json before editing this template; the modifier controls how these values are merged into the live file. */ -}}
{
  "advisorModel": "fable",
  "cleanupPeriodDays": 99999,
  "outputStyle": "Natural Technical Writing",
  "env": {
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "claude-fable-5-1[1m]",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku-4-5",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-5-5[1m]",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-5",
    "CLAUDE_AUTO_BACKGROUND_TASKS": "1",
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "CLAUDE_CODE_DISABLE_CRON": "1",
    "CLAUDE_CODE_DISABLE_MOUSE": "1",
    "CLAUDE_CODE_ENABLE_CFC": "0",
    "CLAUDE_CODE_ENABLE_EXPERIMENTAL_ADVISOR_TOOL": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS": "125000",
    "CLAUDE_CODE_FORK_SUBAGENT": "1",
    "CLAUDE_CODE_GB_DISK_CACHE_WHEN_TELEMETRY_OFF": "1",
    "CLAUDE_CODE_RETRY_WATCHDOG": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_EXTRA_USAGE_COMMAND": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "DISABLE_TELEMETRY": "1",
    "ENABLE_PROMPT_CACHING_1H": "1",
    "ENABLE_TOOL_SEARCH": "1",
    "NODE_USE_ENV_PROXY": "1",
    "USE_BUILTIN_RIPGREP": "0"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "includeGitInstructions": false,
  "disableArtifact": true,
  "disableRemoteControl": true,
  "disableClaudeAiConnectors": true,
  "disableBundledSkills": true,
  "syncClaudeAiSkills": false,
  "syncClaudeAiPlugins": false,
  "skillOverrides": {
    "auto-mode-setup": "off"
  },
  "disableDeepLinkRegistration": "disable",
  "autoMode": {
    "environment": [
      "$defaults",
      "**Secrets management**: envchain (namespaces in the macOS Keychain) is the personal credential store; legitimate use is `envchain <namespace> <command>` to inject a namespace's secrets into one command, and `envchain --list` enumerates namespaces; never print or echo values",
      "**Scope**: the user's own non-public scope is this machine and the accounts and services whose content reaches only the user, the user's own tools, and the services the user chose for the task; a service that stores content at the user's direction is its custodian, not a reader; a user-installed tool that works inside the user's account, and the agent runtime or model route the user has set up on this machine for the task or as a standing choice, are the user's own; an application that sends the content elsewhere without the user choosing it is an outside reader"
    ]
  },
  "permissions": {
    "defaultMode": "auto",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Agent",
      "Bash(herdr:*)",
      "Bash(oracle:*)",
      "Bash(snow:*)",
      "Edit",
      "LSP",
      "mcp__chrome-devtools__*",
      "mcp__plugin_atlassian_atlassian__*",
      "Read",
      "Skill",
      "ToolSearch",
      "WebFetch",
      "WebSearch",
      "Write"
    ],
    "deny": [
      "Bash(*.claude/.credentials.json*)",
      "Bash(*.npmrc*)",
      "Bash(*.zprofile*)",
      "Bash(*.zsh_history*)",
      "Bash(*auth.json*)",
      "Bash(*gh auth token*)",
      "Bash(*private-keys-v1.d*)",
      "DesignSync",
      "Edit(~/.claude/.credentials.json*)",
      "Edit(~/.gnupg/private-keys-v1.d/**)",
      "Edit(~/.npmrc*)",
      "Edit(~/.zprofile*)",
      "Edit(~/*/auth.json*)",
      "EnterPlanMode",
      "ExitPlanMode",
      "Glob",
      "NotebookEdit",
      "PushNotification",
      "Read(**/.env.*.local)",
      "Read(**/.env.local*)",
      "Read(**/.env)",
      "Read(~/.aws/credentials*)",
      "Read(~/.claude/.credentials.json*)",
      "Read(~/.gnupg/private-keys-v1.d/**)",
      "Read(~/.zsh_history*)",
      "Read(~/*/auth.json*)",
      "RemoteTrigger",
      "ReportFindings",
      "ScheduleWakeup"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "excludedCommands": [
      "chezmoi:*",
      "codex:*",
      "docker:*",
      "git:*",
      "herdr:*",
      "oracle:*",
      "snow:*"
    ],
    "filesystem": {
      "allowWrite": [
        "{{ output "getconf" "DARWIN_USER_TEMP_DIR" | trim | trimSuffix "/" }}",
        "/private/tmp/.pnpm-store",
        "~/.bun",
        "~/.cache",
        "~/.cargo",
        "~/.codex",
        "~/.local/share/uv",
        "~/.npm",
        "~/.oracle",
        "~/.pnpm-store",
        "~/.proto",
        "~/.rustup",
        "~/.snowflake/logs",
        "~/Code/.pnpm",
        "~/Library/Caches"
      ],
      "denyRead": [
        "~/.ssh"
      ],
      "allowRead": [
        "~/.ssh/config",
        "~/.ssh/config.*",
        "~/.ssh/*.pub",
        "~/.ssh/allowed_signers",
        "~/.ssh/known_hosts*"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "*.claude.com",
        "context7.com",
        "{{ .private.gitlabHost | trimPrefix "https://" | trimSuffix "/" }}",
        "nodejs.org",
        "{{ .private.npmHost | trimPrefix "https://" | trimSuffix "/" }}",
        "registry.npmjs.org"
      ],
      "allowLocalBinding": true,
      "allowMachLookup": [
        "com.apple.trustd.agent"
      ],
      "allowUnixSockets": [
        "~/.gnupg/S.gpg-agent",
        "~/.gnupg/S.gpg-agent.ssh",
        "~/.gnupg/S.keyboxd"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-tool-guard.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-tool-guard.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-edit-warn-chezmoi.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/post-bash-scan-secrets.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/post-bash-scan-secrets.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-compact-instructions.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '{{ .chezmoi.homeDir }}/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/scripts/statusline.sh"
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {},
  "spinnerTipsEnabled": false,
  "tui": "default",
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Vibing"
    ]
  },
  "alwaysThinkingEnabled": true,
  "autoCompactWindow": 400000,
  "precomputeCompactionEnabled": true,
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "autoDreamEnabled": true,
  "showThinkingSummaries": true,
  "showTurnDuration": false,
  "timeFormat": "24-hour",
  "skipAutoPermissionPrompt": true,
  "skipWorkflowUsageWarning": true
}
