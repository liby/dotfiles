[gpg]
	format = ssh

[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers
	program = ~/.config/git/git-ssh-gpg-agent

# glab records the MR head and base remote in each repository's config on its first `mr create`, a write Claude Code's
# sandbox refuses under the session's working directory; glab reads these keys from any config level and skips the
# write when a value is already set. Any `remote.origin.*` key makes Git list an `origin` remote, so the keys live only
# in this file, whose repositories all have one. A clone whose `origin` is a fork breaks the head-and-base assumption.
[remote "origin"]
	glab-resolved-base = base
	glab-resolved-head = head
