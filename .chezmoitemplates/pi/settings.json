{
  "defaultProjectTrust": "always",
  "defaultProvider": "rc-gateway",
  "defaultModel": "deepseek/deepseek-v4.1-flash-1017",
  "defaultThinkingLevel": "high",
  "defaultTools": ["+codemode"],
  "enabledModels": [
    "rc-gateway/**"{{ range $id, $_ := (includeTemplate "pi/model-overrides.json" . | fromJson).anthropic }},
    {{ printf "anthropic/%s" $id | quote }}{{ end }}
  ],
  "compaction": {
    "reserveTokens": 50000
  },
  "fullscreenCopyOnSelect": false,
  "modelThinkingLevels": {
    "rc-gateway/deepseek/deepseek-v4.1-flash-1017": "max"
  },
  "npmCommand": [
    "npm",
    "--min-release-age-exclude=@earendil-works/*"
  ]
}
