{{- /* chezmoi:modify-template */ -}}
{{- $managed := includeTemplate "claude/claude.json" . | fromJson -}}
{{- $current := .chezmoi.stdin | default "{}" | fromJson -}}
{{- $out := mergeOverwrite (deepCopy $current) $managed -}}
{{- range $name, $server := $managed.mcpServers -}}
  {{- $out = setValueAtPath (list "mcpServers" $name) $server $out -}}
{{- end -}}
{{- if deepEqual $current $out -}}
  {{- .chezmoi.stdin -}}
{{- else -}}
  {{- $out | toPrettyJson -}}
{{- end -}}
