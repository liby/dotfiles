# Must run before anything that references $HOMEBREW_PREFIX.
# Keep the env -u: if both vars are inherited, brew reuses the stale HOMEBREW_PATH, so
# shellenv short-circuits and never adds /opt/homebrew/bin to PATH.
eval "$(env -u HOMEBREW_BREW_FILE -u HOMEBREW_PATH /opt/homebrew/bin/brew shellenv)"

# Homebrew zsh completion path
__BRYAN_HOMEBREW_ZSH_COMPLETION="${HOMEBREW_PREFIX}/share/zsh/site-functions"

# ZSH completions
# https://docs.brew.sh/Shell-Completion#configuring-completions-in-zsh
if (( ! ${fpath[(I)${__BRYAN_HOMEBREW_ZSH_COMPLETION}]} && $+commands[brew] )); then
  fpath+=${__BRYAN_HOMEBREW_ZSH_COMPLETION}
fi
fpath+=$HOME/.zsh/functions
## Initialize the completion system
## This must be done after all fpath modifications
autoload -Uz compinit
# Run the full compinit check once a day
() {
  setopt local_options extendedglob
  if [[ -n ~/.zcompdump(#qN.mh+24) ]]; then
    compinit && touch ~/.zcompdump
  else
    compinit -C
  fi
}

# Shell options
setopt INTERACTIVE_COMMENTS NO_BEEP

# History: INC_APPEND_HISTORY (not _TIME) writes entries pre-exec, so a
# crash keeps the in-flight command at the cost of recorded durations.
HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000
setopt EXTENDED_HISTORY INC_APPEND_HISTORY

# Environment variables
# A terminal opened by an app launched from a Herdr pane inherits the pane's HERDR_*, so `herdr`
# refuses to start as nested and agents act as that pane. ~/.local/bin/open prevents most such
# launches; this cleans up the rest and names every app still holding a pane's environment, so
# it can be relaunched. Terminal apps set their own TERM_PROGRAM, so in an interactive shell only
# a pane has herdr. Framework bundles are skipped: orphaned Homebrew python3 jobs run as one.
# The inherited SSH_AUTH_SOCK is Herdr's agent link, which leaves a Herdr server started here
# without an agent once the link is gone, so use launchd's (`launchctl getenv` does not show it).
if [[ -n $HERDR_ENV && $TERM_PROGRAM != herdr ]]; then
  () {
    local -a apps=(${(uf)"$(ps -A -E -ww -o ppid= -o command= | awk \
      '$1 == 1 && index(" " $0 " ", " HERDR_ENV=1 ") && /^[^=]*\.app\/Contents\/MacOS\// { sub(/\.app\/Contents\/MacOS\/.*/, ""); if (/\.framework\//) next; sub(/.*\//, ""); print }')"})
    print -u2 "zshrc: removed the HERDR_* variables this terminal inherited from a Herdr pane. Quit and reopen from Spotlight or the Dock: ${(j:, :)apps:-this terminal app}"
    if [[ $SSH_AUTH_SOCK == $HERDR_SOCKET_PATH.agent ]]; then
      local agent=$(launchctl print gui/$UID | awk '$1 == "SSH_AUTH_SOCK" && $2 == "=>" { print $3; exit }')
      [[ -S $agent ]] && SSH_AUTH_SOCK=$agent
    fi
  }
  unset -m 'HERDR_*'
fi
export HOMEBREW_BUNDLE_DUMP_NO_VSCODE=1
export HOMEBREW_NO_ENV_HINTS=1
export ORACLE_ENGINE="browser"
export PROTO_AUTO_INSTALL_HIDE_OUTPUT=1
export STARSHIP_CONFIG="$HOME/.config/starship/starship.toml"

# PATH configuration
typeset -aU path
() {
  local -a path_dirs=(
    "$HOMEBREW_PREFIX/opt/curl/bin"
    "$HOMEBREW_PREFIX/opt/uv/bin"
    "$HOME/bin"
    "$HOME/.cargo/bin"
  )
  # Re-front: /etc/zprofile's path_helper demoted the zshenv toolchain dirs.
  path=($__BRYAN_TOOLCHAIN_PATH $path_dirs $path[@])
}

# Alias Set
alias c='open -a "Visual Studio Code"'
alias cc='claude'
alias ccm='claude --switch-provider'
alias cm='chezmoi'
alias cx='open -a /Applications/ChatGPT.app'
alias hr='herdr'
# Run outside Herdr; stopping the server terminates its pane processes.
alias hrr='herdr server stop && herdr'
alias ip="curl ip.sb"
alias ipcn="curl myip.ipip.net"
alias la='ls --all'
alias ll='la --long --git --time-style=long-iso --no-user'
alias ls='eza --group-directories-first --hyperlink=auto'
alias lt='ll --tree --level=2 --git-ignore --ignore-glob=.git'
alias python='python3'

# Functions (autoloaded from ~/.zsh/functions/)
autoload -Uz $HOME/.zsh/functions/*(N:t)

# Skip per-precmd widget rebinding for faster prompt
ZSH_AUTOSUGGEST_MANUAL_REBIND=""

# Source plugins and configurations
source $HOME/.zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
source $HOME/.zsh/plugins/fsh/fast-syntax-highlighting.plugin.zsh
# fsh's default comment style (black,bold) is unreadable on a dark background
FAST_HIGHLIGHT_STYLES[comment]='fg=248'

# Clear stale suggestion after paste (not in plugin defaults)
# https://github.com/zsh-users/zsh-autosuggestions/issues/351
ZSH_AUTOSUGGEST_CLEAR_WIDGETS+=(bracketed-paste)

# Initialize tools and configurations
export GPG_TTY="$TTY"
# Guard on the file, not `orb`: the brew-cask CLI exists before ~/.orbstack/,
# which OrbStack.app only creates on first run.
[[ -r ~/.orbstack/shell/init.zsh ]] && source ~/.orbstack/shell/init.zsh
(( $+commands[proto] )) && eval "$(proto activate zsh)"
eval "$(starship init zsh)"
eval "$(zoxide init zsh)"
