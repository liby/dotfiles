export PNPM_HOME="$HOME/Code/.pnpm"
export PROTO_HOME="$HOME/.proto"
export NPM_CONFIG_PREFIX="$PROTO_HOME/tools/node/globals"
export PROTO_AUTO_INSTALL_HIDE_OUTPUT=1
# proto owns the Go toolchain; `auto` would let go download its own copy into $GOPATH/pkg/mod,
# outside proto's inventory and invisible to `proto status`/`outdated`/`auto-clean`.
export GOTOOLCHAIN=local
# glab still reads ~/.config/glab-cli before its macOS default under ~/Library/Application Support,
# but only so configurations made before that default keep working; select it explicitly.
export GLAB_CONFIG_DIR="$HOME/.config/glab-cli"
export ORACLE_ENGINE="browser"
export STARSHIP_CONFIG="$HOME/.config/starship/starship.toml"
export TZ=Asia/Singapore

typeset -U path fpath
# zprofile re-fronts this list after /etc/zprofile's path_helper and brew shellenv demote it.
__BRYAN_TOOLCHAIN_PATH=(
  "$PROTO_HOME/shims"
  "$PROTO_HOME/bin"
  "$NPM_CONFIG_PREFIX/bin"
  "$PNPM_HOME/bin"
  "$HOME/go/bin"
  # The provider-aware `claude` launcher must shadow the native install in ~/.local/bin.
  "$HOME/.local/share/claude-launcher/bin"
  "$HOME/.local/bin"
  # `mbx setup` installs its Cargo shim in the platform data directory, which on macOS is
  # ~/Library/Application Support regardless of XDG, and has no setting to move it. The shim
  # runs the real Cargo it finds later on PATH, so both live in this list and the shim comes first.
  "$HOME/Library/Application Support/mbx/bin"
  "$HOME/.cargo/bin"
)
path=($__BRYAN_TOOLCHAIN_PATH $path)
# Rex adds its CLI to PATH only in its own terminals. Appended, the running server's copy reaches
# other terminals, desktop agent apps, and chezmoi scripts without overriding a terminal's own.
path+=("$HOME/Library/Application Support/com.superlogical.rex/RexServer/Versions/Current/Rex Server.app/Contents/MacOS")
