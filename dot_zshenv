export PNPM_HOME="$HOME/Code/.pnpm"
export PROTO_HOME="$HOME/.proto"
export NPM_CONFIG_PREFIX="$PROTO_HOME/tools/node/globals"
# proto owns the Go toolchain; `auto` would let go download its own copy into $GOPATH/pkg/mod,
# outside proto's inventory and invisible to `proto status`/`outdated`/`auto-clean`.
export GOTOOLCHAIN=local
export TZ=Asia/Singapore

typeset -aU path
# zshrc re-fronts this list after /etc/zprofile's path_helper demotes it.
__BRYAN_TOOLCHAIN_PATH=(
  "$PROTO_HOME/shims"
  "$PROTO_HOME/bin"
  "$NPM_CONFIG_PREFIX/bin"
  "$PNPM_HOME/bin"
  "$HOME/go/bin"
  "$HOME/.local/bin"
  # `mbx setup` installs its Cargo shim in the platform data directory, which on macOS is
  # ~/Library/Application Support regardless of XDG, and has no setting to move it. The shim
  # runs the real Cargo it finds later on PATH, so both live in this list and the shim comes first.
  "$HOME/Library/Application Support/mbx/bin"
  "$HOME/.cargo/bin"
)
path=($__BRYAN_TOOLCHAIN_PATH $path)
export PATH

# Codex uses non-interactive zsh, so expose only its provider-aware Claude launcher here.
autoload -Uz "$HOME/.zsh/functions/claude"
