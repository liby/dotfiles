#!/bin/zsh -f
# claude: provider-aware launcher wrapping the Claude Code binary.
#
# PATH lists this directory ahead of ~/.local/bin, where the native installer owns `claude`, so
# every shell, wrapper, and script that looks `claude` up on PATH gets the persisted mode.
#
# claude [args...]                       Launch in the current mode.
# claude --switch-provider [args...]     Pick a provider, save it, then launch.
# claude --gateway [args...]             Use the gateway for this call.
# claude --subscription [args...]        Use the subscription for this call.

local pick=0
local mode_override=
while (( $# )); do
  case $1 in
    --switch-provider)
      pick=1
      shift
      ;;
    --gateway|--subscription)
      mode_override=${1#--}
      shift
      ;;
    *)
      break
      ;;
  esac
done

local config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/claude-code"
local mode_file="$config_dir/mode"
local native=$HOME/.local/bin/claude

local mode=subscription
[[ -f $mode_file ]] && mode=$(< $mode_file)
[[ -n $mode_override ]] && mode=$mode_override

if (( pick )); then
  [[ -t 0 && -t 1 ]] || { print -u2 "claude: --switch-provider requires an interactive terminal"; exit 1 }

  local selected=1
  [[ $mode == gateway ]] && selected=0

  local cursor=$selected
  local -a labels=(Gateway Subscription) modes=(gateway subscription)
  local key seq first=1
  local teardown=$'\e[2A\e[J\e[?25h'
  local i marker line

  print -n '\e[?25l'
  trap 'print -n $teardown; exit 130' INT

  while true; do
    (( first )) || print -n '\e[2A'
    first=0
    for i in 0 1; do
      (( i == selected )) && marker='●' || marker='○'
      line="  $marker ${labels[i+1]}"
      if (( i == cursor )); then
        print -rn -- $'\e[48;5;237m'"$line"$'\e[K\e[0m'
      else
        print -rn -- "$line"$'\e[K'
      fi
      print
    done

    read -rsk1 key
    case $key in
      $'\e')
        seq=; read -rsk1 -t 0.05 seq 2>/dev/null
        if [[ -z $seq ]]; then
          print -n $teardown
          exit 1
        fi
        seq=; read -rsk1 -t 0.05 seq 2>/dev/null
        [[ $seq == [AB] ]] && (( cursor ^= 1 ))
        ;;
      ' '|$'\n')
        selected=$cursor
        break
        ;;
    esac
  done

  print -n $teardown

  mode=$modes[selected+1]
  mkdir -p "$config_dir" || exit 1
  print -n "$mode" > "$mode_file" || exit 1
fi

if [[ $mode == gateway ]]; then
  local name value
  for name in ANTHROPIC_AUTH_TOKEN ANTHROPIC_VERTEX_BASE_URL ANTHROPIC_VERTEX_PROJECT_ID; do
    value=$(mk get claude-gateway/$name) || exit
    export $name=$value
  done
  export CLAUDE_CODE_USE_VERTEX=1 CLAUDE_CODE_SKIP_VERTEX_AUTH=1
  exec "$native" "$@"
fi

# Children of a gateway session inherit its variables, which would still select the gateway.
# Unset them by name so the cleanup holds when mk or its entries are unavailable.
unset ANTHROPIC_AUTH_TOKEN ANTHROPIC_VERTEX_BASE_URL ANTHROPIC_VERTEX_PROJECT_ID CLAUDE_CODE_SKIP_VERTEX_AUTH CLAUDE_CODE_USE_VERTEX
exec "$native" "$@"
