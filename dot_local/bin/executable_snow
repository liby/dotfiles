#!/opt/homebrew/opt/snowflake-cli/libexec/bin/python
# Run Homebrew's Snowflake CLI with its browser-SSO tokens cached in a file, so one sign-in serves
# every later snow process until the token expires. On macOS the connector caches tokens only in
# the Keychain, whose approvals bind to the code signature of Homebrew's ad hoc-signed Python and
# lapse at every Python upgrade, prompting again in each concurrent process. Its Linux cache,
# ~/.cache/snowflake/credential_cache_v1.json, is a mode 0600 file-locked JSON file instead.
import os
import sys
from importlib.metadata import entry_points

# Connector 5 caches through its Rust core and has no token_cache module. Let this import fail at
# that upgrade: catching it would silently fall back to the Keychain and its prompts.
from snowflake.connector import token_cache

# TokenCache.make is the only reader of these flags in token_cache, so this selects the Linux
# file cache and nothing else. Caching stays on: connection.py forces it on macOS through its own
# imported copy of IS_LINUX, which must stay unpatched.
token_cache.IS_MACOS = False
token_cache.IS_LINUX = True

# Python's default macOS opener brings the browser to the front. Resolve `open` through PATH so the
# Herdr-aware wrapper in ~/.local/bin applies.
os.environ.setdefault("BROWSER", "open -g %s")
(snow,) = entry_points(group="console_scripts", name="snow")
sys.exit(snow.load()())
