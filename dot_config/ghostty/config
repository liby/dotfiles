auto-update = check
auto-update-channel = tip

cursor-style = block
cursor-style-blink = false

# Inconsolata LGC 3.201 (Nerd Fonts 3.5.0) shrank its line height by 25%.
# 30% (not the raw 33% ratio) lands on the exact old 35px cell after pixel
# rounding, at font-size 12 on 2x displays; re-tune if any of those change.
adjust-cell-height = 30%
font-codepoint-map = "U+27F3=STIX Two Math"
font-family = "Inconsolata LGC Nerd Font Mono"
font-family = "PingFang SC"
font-size = 12

keybind = ctrl+alt+i=inspector:toggle
keybind = super+u=text:\x1f
keybind = super+z=text:\x1a

macos-option-as-alt = true

shell-integration = zsh
shell-integration-features = no-cursor

theme = "Snazzy Soft"

window-padding-x = 8
window-padding-y = 8
