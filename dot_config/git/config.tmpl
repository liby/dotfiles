{{- $gitlabHost := .private.gitlabHost | trimPrefix "https://" | trimSuffix "/" -}}
[alias]
  st = status

  ### amend ###
  aa = "!git add -A && git commit --amend --no-edit"
  as = commit --amend --no-edit

  ### log ###
  lg = log --graph --abbrev-commit --date=short --boundary --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cd) %Cblue[%cn]%Creset'

  ### push ###
  pf = push --force-with-lease

  ### rebase ###
  fix = "!f() { git add -A && git commit --fixup $1 && GIT_SEQUENCE_EDITOR=true git rebase -i $1^; }; f"
  rb = rebase
  rba = rebase --abort
  rbc = rebase --continue
  rbs = rebase --skip

  ### sync ###
  base = !git fetch origin && git reset --hard origin/HEAD
  sync = !git fetch origin && git reset --hard @{u}

  ### tag ###
  lt = for-each-ref --merged=HEAD --sort=-creatordate --count=1 --format='%(refname:short)' refs/tags

[branch]
  autosetuprebase = always
  sort = -committerdate

[column]
  ui = auto

[core]
  autocrlf = input
  editor = vim
  quotepath = false

# Drop the system-level catch-all osxkeychain helper (Homebrew and Apple Git) so hosts get only the helpers declared below;
# otherwise Git stores the Claude Code sandbox's per-session localhost proxy credential in the login keychain.
# The empty value clears every helper configured before it, so keep it above the per-host sections.
[credential]
  helper =

[credential "https://gist.github.com"]
  helper = 
  helper = !/opt/homebrew/bin/gh auth git-credential

[credential "https://github.com"]
  helper = 
  helper = !/opt/homebrew/bin/gh auth git-credential

[credential "https://{{ $gitlabHost }}"]
  helper =
  helper = !/opt/homebrew/bin/glab auth git-credential

[diff]
  algorithm = histogram
  colorMoved = plain

[fetch]
  prune = true
  pruneTags = false
  writeCommitGraph = true

[filter "lfs"]
  clean = /opt/homebrew/bin/git-lfs clean -- %f
  process = /opt/homebrew/bin/git-lfs filter-process
  required = true
  smudge = /opt/homebrew/bin/git-lfs smudge -- %f

[help]
  autocorrect = prompt

[merge]
  conflictStyle = zdiff3

[pull]
  rebase = true

[push]
  autoSetupRemote = true
  useForceIfIncludes = true

[rebase]
  autosquash = true
  autostash = true
  missingCommitsCheck = error
  updateRefs = false

[rerere]
  enabled = true

[status]
  showStash = true

# Claude Code's macOS sandbox cannot tunnel SSH (anthropics/claude-code#70684), so Git reaches both forges over HTTPS
# with the forge CLIs' tokens. Remove once a sandboxed `git ls-remote ssh://git@github.com/<owner>/<repo>.git` succeeds;
# a `git@github.com:` URL cannot test this because these rules send it over HTTPS.
{{ range list "github.com" $gitlabHost -}}
[url "https://{{ . }}/"]
  insteadOf = git@{{ . }}:

{{ end -}}
[include]
  path = github.config

[includeIf "gitdir:~/Code/GitLab/"]
  path = gitlab.config

[includeIf "gitdir:~/Code/"]
  path = performance.config
