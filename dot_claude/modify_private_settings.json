{{- /* chezmoi:modify-template */ -}}
{{- /* Partially manage ~/.claude/settings.json; the Ownership section of
      .claude/rules/claude-code-settings.md decides each key's role. Managed
      top-level subtrees replace live values, so nested removals apply;
      removing a top-level key only stops ownership and requires separate
      live cleanup. Seeds are written only when the key is missing, so a
      changed seed value never reaches existing machines. Undeclared keys
      pass through. */ -}}
{{- $managed := includeTemplate "claude/settings.json" . | fromJson -}}
{{- $seeds := `{
  "model": "opus",
  "effortLevel": "high"
}` | fromJson -}}
{{- $stdin := .chezmoi.stdin -}}
{{- $current := dict -}}
{{- if $stdin -}}{{- $current = fromJson $stdin -}}{{- end -}}
{{- $out := deepCopy $current -}}
{{- range $k, $v := $managed -}}{{- $out = set $out $k $v -}}{{- end -}}
{{- range $k, $v := $seeds -}}
{{-   if not (hasKey $out $k) -}}{{- $out = set $out $k $v -}}{{- end -}}
{{- end -}}
{{- if deepEqual $current $out -}}
  {{- $stdin -}}
{{- else -}}
  {{ toPrettyJson $out }}
{{- end -}}
