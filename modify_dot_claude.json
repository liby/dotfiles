{{- /* chezmoi:modify-template */ -}}
{{- /* Overlay declared keys and replace each source-declared MCP server whole;
      undeclared keys and servers pass through. */ -}}
{{- $managed := includeTemplate "claude/claude.json" . | fromJson -}}
{{- $stdin := .chezmoi.stdin -}}
{{- $current := dict -}}
{{- if $stdin -}}{{- $current = fromJson $stdin -}}{{- end -}}
{{- $out := mergeOverwrite (deepCopy $current) $managed -}}
{{- range $name, $server := index $managed "mcpServers" -}}
  {{- $out = setValueAtPath (list "mcpServers" $name) $server $out -}}
{{- end -}}
{{- if deepEqual $current $out -}}
  {{- $stdin -}}
{{- else -}}
  {{ toPrettyJson $out }}
{{- end -}}
