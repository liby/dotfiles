#!/bin/zsh
set -euo pipefail

# prototools hash: {{ include "dot_proto/dot_prototools" | sha256sum }}
# mbx installer hash: {{ include ".github/dev-tools/install-mbx.sh" | sha256sum }}
{{- $manifest := include ".github/dev-tools/package.json" | fromJson -}}
{{- $tools := index $manifest "devDependencies" }}

source "$CHEZMOI_SOURCE_DIR/.chezmoiscripts/.lib/step.zsh"

eval "$(/opt/homebrew/bin/brew shellenv)"
path=($__BRYAN_TOOLCHAIN_PATH $path)
npm_prefix="$NPM_CONFIG_PREFIX"

# Tool declarations live in `~/.proto/.prototools`. The default `upwards` config mode walks up
# from the working directory without merging that file, leaving a bare `proto install` nothing
# to install. proto skips each declared version it already has. The fixed path keeps a lookup
# from falling back to a self-managed proto in `$PROTO_HOME/bin`; Brewfile owns the executable.
step /opt/homebrew/bin/proto install --config-mode global

# Keep this at most as long as the npm rule in .github/renovate.json, or the pins below
# become unreachable.
npm config set min-release-age 3

npm_tools=(
{{ range $name := keys $tools | sortAlpha -}}
  "{{ $name }}@{{ index $tools $name }}"
{{ end -}}
)

# Other machine-local globals may coexist in this prefix.
npm_tree="$(npm ls --global --depth=0 --json --prefix "$npm_prefix" 2>/dev/null || true)"
npm_pending=()
for spec in "${npm_tools[@]}"; do
  name="${spec%@*}"
  version="${spec##*@}"
  current="$(
    jq -r --arg name "$name" '.dependencies[$name].version // empty' \
      <<< "$npm_tree"
  )"
  [[ "$current" == "$version" ]] || npm_pending+=("$spec")
done

if (( ${#npm_pending[@]} )); then
  step npm install --global \
    --prefix "$npm_prefix" \
    --ignore-scripts \
    -- "${npm_pending[@]}"
fi

# uv skips a requirement already installed and replaces a different version. Renovate gates the
# pin but not Pyright's transitive dependencies. Take the window from source so the command
# carries it without depending on uv discovering `~/.config/uv/uv.toml`.
step uv tool install \
  --exclude-newer '{{ index (include "dot_config/uv/uv.toml" | fromToml) "exclude-newer" }}' \
  '{{ include ".github/dev-tools/requirements.txt" | trim }}'

sh "{{ .chezmoi.sourceDir }}/.github/dev-tools/install-mbx.sh" "$HOME/.local/bin"
# The store shares the Code volume with the checkouts, so mbx adopts an existing `target/` by
# rename and restores outputs as APFS clones. `settings set` keeps the file's other keys.
mbx settings set cache_dir "$HOME/Code/.mbx"
step mbx setup --yes
