set -euo pipefail

# rime-ice pin: {{ index (include ".chezmoiexternal.toml" | fromToml) "Library/Rime" | toJson | sha256sum }}
# default.custom.yaml hash: {{ include "private_Library/Rime/default.custom.yaml" | sha256sum }}
# rime_ice.custom.yaml hash: {{ include "private_Library/Rime/rime_ice.custom.yaml" | sha256sum }}
# squirrel.custom.yaml hash: {{ include "private_Library/Rime/squirrel.custom.yaml" | sha256sum }}
# caps_lock_passthrough.lua hash: {{ include "private_Library/Rime/lua/caps_lock_passthrough.lua" | sha256sum }}
# han_alnum_spacer.lua hash: {{ include "private_Library/Rime/lua/han_alnum_spacer.lua" | sha256sum }}
# english_guess_filter.lua hash: {{ include "private_Library/Rime/lua/english_guess_filter.lua" | sha256sum }}

# Not `Squirrel --reload`: a running Squirrel keeps the Lua modules it loaded first. It redeploys
# changed configuration on start, and macOS relaunches it when text input next needs it.
if pgrep -qx Squirrel; then
  killall Squirrel
fi
