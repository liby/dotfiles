#!/bin/zsh
set -euo pipefail

gpg_bin="/opt/homebrew/bin/gpg"

git_config_dir="$HOME/.config/git"
mkdir -p "$git_config_dir"

card_status=$("$gpg_bin" --card-status) || {
  print -u2 "Error: YubiKey not available; insert it and retry"
  exit 1
}
gpg_key_id=$(/usr/bin/awk '
  /^sec/ { split($2, fields, "/"); print fields[2]; exit }
' <<< "$card_status")
[[ -n "$gpg_key_id" ]] || {
  print -u2 "Error: no secret key for the YubiKey; import its public key and retry"
  exit 1
}

gpg_ssh_public_key=$("$gpg_bin" --export-ssh-key "$gpg_key_id") || exit $?

install_config() {
  local destination=$1 signing_key=$2 temporary install_status=0
  temporary=$(mktemp "$git_config_dir/.${destination:t}.XXXXXX") || return $?
  {
    cat > "$temporary" &&
      /usr/bin/git config --file "$temporary" user.signingkey "$signing_key" &&
      mv "$temporary" "$destination"
  } || install_status=$?
  rm -f "$temporary"
  return "$install_status"
}

install_config "$git_config_dir/github.config" "$gpg_key_id" <<'EOF'
{{ includeTemplate "git/github.config" . -}}
EOF

# key:: keeps the public key inside the config, so signing reads nothing from ~/.ssh.
install_config "$git_config_dir/gitlab.config" "key::$gpg_ssh_public_key" <<'EOF'
{{ includeTemplate "git/gitlab.config" . -}}
EOF
