#!/bin/zsh
set -euo pipefail

[[ "$OSTYPE" == darwin* ]] || exit 0

defaults write NSGlobalDomain ApplePressAndHoldEnabled -bool false
defaults write NSGlobalDomain InitialKeyRepeat -int 15
defaults write NSGlobalDomain KeyRepeat -int 2
defaults write NSGlobalDomain AppleICUForce24HourTime -bool true
defaults delete NSGlobalDomain AppleICUForce12HourTime 2>/dev/null || true

defaults write com.apple.dock autohide -bool true

defaults write com.apple.finder AppleShowAllFiles -bool true
defaults write com.apple.finder FXEnableExtensionChangeWarning -bool false

defaults write com.apple.menuextra.clock DateFormat -string "EEE HH:mm"

defaults write com.openai.codex requirements_toml_base64 -string \
  '{{ includeTemplate "codex-requirements.toml" . | b64enc }}'

# Reload processes that cache the Apple UI defaults.
killall ControlCenter Dock Finder
