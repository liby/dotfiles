#!/bin/zsh
set -euo pipefail

source "$CHEZMOI_SOURCE_DIR/.chezmoiscripts/.lib/step.zsh"

# Settings hash: {{ include ".chezmoitemplates/input-source-pro/settings.json" | sha256sum }}

# Input Source Pro keeps its app and website rules in a Core Data store and many preferences as
# archived values in com.runjuu.Input-Source-Pro. The exported JSON is what this repository
# tracks, and the app loads it through the import URL below.
app="Input Source Pro"
settings="{{ .chezmoi.sourceDir }}/.chezmoitemplates/input-source-pro/settings.json"

# LaunchServices only acknowledges URL dispatch; the app reports the import result.
# Launch the app first and wait for its process so first-run Gatekeeper prompts do not
# interrupt URL delivery.
print -u2 -r -- "$step_yellow!$step_reset Answer any first-launch prompts from $app"
open -a "$app"

# Match on the bundle id: `lsappinfo info <name>` returns nothing while two copies of the app
# run under the same name, such as a local Xcode build next to the /Applications copy.
waited=0
until [[ -n "$(lsappinfo find 'bundleid="com.runjuu.Input-Source-Pro"')" ]]; do
  if (( ++waited > 60 )); then
    print -u2 -r -- "$step_red✗$step_reset $app did not start, so its settings were not imported; rerun chezmoi apply"
    exit 1
  fi
  sleep 1
done

print -u2 -r -- "$step_yellow!$step_reset Check $app's alert for the result of the settings import"
open "inputsourcepro://import?path=$settings"
