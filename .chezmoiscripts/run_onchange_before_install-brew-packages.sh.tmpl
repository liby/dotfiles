#!/bin/zsh
set -euo pipefail

# Brewfile hash: {{ include "Brewfile" | sha256sum }}

[[ "$OSTYPE" == darwin* ]] || exit 0

if [[ ! -x /opt/homebrew/bin/brew ]]; then
  echo "Installing Homebrew..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

  # Homebrew installer doesn't always set up .zprofile
  zprofile="$HOME/.zprofile"
  if [[ ! -e "$zprofile" ]] || ! grep -q "brew shellenv" "$zprofile"; then
    echo 'eval "$(/opt/homebrew/bin/brew shellenv)"' >> "$zprofile"
    echo "typeset -U path" >> "$zprofile"
  fi

  /opt/homebrew/bin/brew analytics off
fi

eval "$(/opt/homebrew/bin/brew shellenv)"

brewfile="{{ .chezmoi.sourceDir }}/Brewfile"
if [[ ! -f "$brewfile" ]]; then
  echo "No Brewfile found at $brewfile"
  exit 1
fi

# mas-cli requires en_US locale to search the App Store
# https://github.com/mas-cli/mas/blob/ed676787f0a0a26e23a10548eb841bc15411fa52/Sources/mas/Controllers/ITunesSearchAppStoreSearcher.swift#L18-L23
current_locale=$(defaults read NSGlobalDomain AppleLocale 2>/dev/null || true)
restore_locale() {
  local exit_status=$1
  trap - EXIT
  if [[ -n "$current_locale" ]]; then
    defaults write NSGlobalDomain AppleLocale -string "$current_locale"
  fi
  exit "$exit_status"
}
trap 'restore_locale $?' EXIT

if [[ -n "$current_locale" ]]; then
  defaults write NSGlobalDomain AppleLocale -string en_US
fi

echo "Installing brew packages..."
# A transient brew bundle failure would abort the whole apply.
attempt=1
until brew bundle --file="$brewfile"; do
  (( attempt++ < 3 )) || exit 1
  echo "brew bundle failed; retrying (attempt $attempt/3)..."
  sleep 10
done
