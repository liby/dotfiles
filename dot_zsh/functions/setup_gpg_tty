[[ -n "$TTY" ]] || return 0

export GPG_TTY="$TTY"

# common.conf sets no-autostart: nothing may start gpg-agent implicitly, so a
# sandboxed AI shell can never birth an agent that inherits its seatbelt
# profile for life and loses the YubiKey. Human terminals (which set
# TERM_PROGRAM; AI-created ptys do not) are the designated birthplace.
# gpg-connect-agent exits 0 even with no agent running, so probe liveness via
# its output, not its exit code.
if [[ -n "${TERM_PROGRAM:-}" ]] \
  && ! gpg-connect-agent --no-autostart 'getinfo pid' /bye 2>/dev/null | grep -q '^D '; then
  # Losing the start race to a concurrent tab is fine; updatestartuptty below
  # talks to whichever agent won.
  gpg-agent --daemon >/dev/null 2>&1 || true
fi

gpg-connect-agent --no-autostart updatestartuptty /bye >/dev/null 2>&1
return 0
